<div class="max-w-4xl mx-auto px-4">
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="md:flex">
      <div class="md:w-1/3 bg-gray-100 flex items-center justify-center p-4 min-h-64">
        <% if @book_post.image.attached? %>
          <%= image_tag @book_post.image, class: "max-h-80 max-w-full object-contain" %>
        <% else %>
          <span class="text-gray-400">No Image</span>
        <% end %>
      </div>
      <div class="p-6 md:w-2/3">
        <h1 class="text-2xl font-bold text-gray-800"><%= @book_post.title %></h1>
        <p class="text-gray-600 mt-2">著者: <%= @book_post.author %></p>
        <p class="text-sm text-gray-500 mt-1">投稿者: <%= @book_post.user.name %></p>
        <p class="text-sm text-gray-500"><%= @book_post.created_at.strftime("%Y年%m月%d日") %></p>

        <div class="mt-4 p-4 bg-gray-50 rounded-md">
          <h3 class="font-semibold text-gray-700 mb-2">おすすめポイント</h3>
          <p class="text-gray-600 whitespace-pre-wrap"><%= @book_post.body %></p>
        </div>

        <div class="flex items-center space-x-4 mt-6">
          <div id="like-button">
            <%= render partial: "likes/button", locals: { book_post: @book_post } %>
          </div>
          <span class="text-gray-500">💬 <%= @book_post.comments.count %> コメント</span>
        </div>

        <% if logged_in? && @book_post.user == current_user %>
          <div class="flex space-x-2 mt-6">
            <%= link_to "編集", edit_book_post_path(@book_post), class: "bg-gray-600 text-white px-4 py-2 rounded-md hover:bg-gray-700" %>
            <%= button_to "削除", book_post_path(@book_post), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- コメント欄 -->
  <div class="mt-8 bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold mb-4">コメント</h2>

    <% if logged_in? %>
      <%= form_with model: [@book_post, @comment], class: "mb-6" do |f| %>
        <div>
          <%= f.text_area :body, placeholder: "コメントを入力...", rows: 3, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
        </div>
        <div class="mt-2">
          <%= f.submit "コメントする", class: "bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 cursor-pointer" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-500 mb-4"><%= link_to "ログイン", login_path, class: "text-indigo-600 hover:underline" %>してコメントしましょう</p>
    <% end %>

    <div id="comments" class="space-y-4">
      <% @book_post.comments.includes(:user).order(created_at: :desc).each do |comment| %>
        <%= render partial: "comments/comment", locals: { comment: comment } %>
      <% end %>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to "← 一覧に戻る", root_path, class: "text-indigo-600 hover:underline" %>
  </div>
</div>
