<%= form_with model: book_post, class: "space-y-4" do |f| %>
  <% if book_post.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <ul class="text-red-600 text-sm">
        <% book_post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "書籍タイトル", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :author, "著者名", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :author, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :body, "おすすめポイント", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :body, rows: 5, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :image, "書籍の画像", class: "block text-sm font-medium text-gray-700" %>
    <%= f.file_field :image, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
    <% if book_post.image.attached? %>
      <div class="mt-2">
        <p class="text-sm text-gray-500">現在の画像:</p>
        <%= image_tag book_post.image, class: "mt-1 w-32 h-32 object-cover rounded-md" %>
      </div>
    <% end %>
  </div>

  <div class="flex space-x-4">
    <%= f.submit book_post.persisted? ? "更新する" : "投稿する", class: "bg-indigo-600 text-white px-6 py-2 rounded-md hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "キャンセル", book_post.persisted? ? book_post_path(book_post) : root_path, class: "bg-gray-300 text-gray-700 px-6 py-2 rounded-md hover:bg-gray-400" %>
  </div>
<% end %>
